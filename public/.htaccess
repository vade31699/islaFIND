# ============================================================
# .htaccess — Apache configuration for the islaFIND WEB ROOT
#
# This directory is the application's document root: the only place
# a web server should ever serve from. Everything private — .env,
# the SQL dump, composer.json/lock, certs/, vendor/ and every shared
# include — lives one level up and is therefore unreachable over
# HTTP on ANY server, whether or not it honours this file.
#
# Optional by design: every rule here is a nicety, not a dependency.
# On a server that ignores .htaccess (nginx, or Apache with
# AllowOverride None) the app still runs — it simply loses the
# branded 404 screen and the extra hardening below. On Laravel
# Cloud, which is nginx, that is exactly what happens; see README
# ("Deploying") for what replaces each rule.
#
# Requires the Apache modules: mod_rewrite (bundled and enabled by
# default in WAMP), mod_headers, mod_deflate and mod_expires.
# ============================================================

# --- 1. Branded error pages -------------------------------------
# A missing URL gets the app's own 404 screen instead of Apache's
# bare "Not Found" page. 404.php is deliberately standalone.
ErrorDocument 404 /404.php
ErrorDocument 403 /404.php

# --- 2. Never serve the secrets, even if one lands here ---------
# The private files live outside this directory, so on a correctly
# configured server these rules never fire. They are kept as a
# safety net: if a stray .env or dump is ever copied into the web
# root, it is still not downloadable.
<FilesMatch "^(\\.env(\\..*)?|composer\\.(json|lock)|final_app\\.sql|.*\\.(md|log|ini|bak))$">
    Require all denied
</FilesMatch>

# --- 3. Hardening headers --------------------------------------
<IfModule mod_headers.c>
    # Stop browsers from second-guessing a declared content type
    # (also removes a whole class of "image that is really HTML"
    # attacks on uploaded files).
    Header set X-Content-Type-Options "nosniff"

    # The app is never meant to be framed by another site. (It is
    # fine inside its OWN pages, hence SAMEORIGIN rather than DENY.)
    Header set X-Frame-Options "SAMEORIGIN"

    # Do not leak the full URL of one page to the next site.
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # No flash/geolocation/camera for anyone by default; each page
    # asks for the one capability it needs (geolocation on the
    # profile form) with the browser's own prompt.
    Header set Permissions-Policy "geolocation=(self), camera=(), microphone=()"
</IfModule>

# NOTE on a Content-Security-Policy: deliberately NOT set here.
# Every page uses inline <script> blocks, inline onsubmit="..."
# handlers and a couple of inline styles, so a strict CSP would break
# the app outright. Adding one is a real hardening step, but only
# after those inline scripts are externalised AND nonce-based — see
# the notes in README.md ("Security" section).

# NOTE on session cookies: HttpOnly / Secure / SameSite are set in
# CODE by session_harden() (include/security.php) before every
# session_start(), and Apache must not append a second SameSite to
# that header — a duplicate attribute makes browsers drop the
# cookie, which would break login inside mobile-preview iframes.

# --- 5. Compression + caching for static assets ----------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On

    # style.css and the .js files are edited constantly while the app
    # is being worked on, and a browser holding yesterday's script is
    # a genuinely confusing bug ("I fixed it but nothing changed").
    # They are therefore revalidated on every load — the browser still
    # gets a 304 when nothing changed, so the cost is one round trip.
    ExpiresByType text/css               "access plus 0 seconds"
    ExpiresByType application/javascript "access plus 0 seconds"

    # Uploaded photos and the logo never change under the same name,
    # so they can be cached hard.
    ExpiresByType image/svg+xml       "access plus 1 month"
    ExpiresByType image/jpeg          "access plus 1 month"
    ExpiresByType image/png           "access plus 1 month"
</IfModule>

# --- 6. Directory listings off ----------------------------------
Options -Indexes
