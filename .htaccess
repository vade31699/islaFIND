# ============================================================
# .htaccess — PROJECT ROOT (not the document root)
#
# The application's real web root is public/. Only public/ is meant
# to be served; everything beside it — include/, certs/, vendor/,
# final_app.sql, composer.json and .env — must never be reachable
# over HTTP.
#
# This file exists for ONE reason: local WAMP convenience. Where the
# project folder itself is the served directory (http://localhost/
# islaFIND/), the rewrite below forwards every request into public/,
# so the app answers at exactly the URL it always has:
#
#     http://localhost/islaFIND/index.php
#
# On Laravel Cloud the web server is nginx, which ignores .htaccess
# entirely, so the document root must be set to public/ there. This
# file then has no effect at all — which is fine, because with the
# document root on public/ the private files are already outside it.
#
# The rules that actually harden the app (branded 404, security
# headers, compression, caching) live in public/.htaccess.
# ============================================================

# --- 1. Forward everything into the real web root ---------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Deliberately unconditional. Every file that should be servable
    # now lives under public/, so letting an existing root-level file
    # pass through would hand out README.md, final_app.sql and the
    # composer files.
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# --- 2. Safety net if mod_rewrite is unavailable ----------------
# Without the rewrite above the app is not reachable from this
# directory at all, so the only thing left to protect is the
# secrets themselves. Deny them by name rather than relying on the
# rewrite.
<FilesMatch "^\.env(\..*)?$">
    Require all denied
</FilesMatch>
<FilesMatch "^final_app\.sql$">
    Require all denied
</FilesMatch>

# --- 3. Directory listings off ----------------------------------
Options -Indexes
