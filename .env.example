# Copy this file to .env and fill in your real credentials.
# .env is NOT committed to version control; .env.example is.

# ------------------------------------------------------------------
# Database (read by db.php via env.php).
# The values below are the WAMP defaults, which is what the fallbacks
# in db.php use anyway — so you only need these lines if you want the
# configuration to be explicit or you are pointing at another server.
# ------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=final_app
DB_USER=root
DB_PASS=

# ------------------------------------------------------------------
# Database TLS (read by db.php, section 3b).
# Leave DB_SSL_CA out or empty for a local WAMP MySQL: it speaks
# plaintext and needs nothing here.
#
# Managed MySQL (TiDB Cloud Serverless, PlanetScale, ...) REFUSES
# plaintext connections, so there DB_SSL_CA is mandatory — without it
# the app cannot connect at all. Two details confirmed by testing
# against TiDB Cloud Starter:
#   * the value is a path to a CA certificate file, either absolute or
#     relative to the project root. certs/lets-encrypt-roots.pem is
#     committed and works as-is: TiDB Starter's certificates are
#     issued by Let's Encrypt, so no provider-specific CA download is
#     needed (that is a TiDB Cloud *Dedicated* thing).
#   * PDO has no "use TLS" switch — handing it a CA is what turns the
#     encrypted connection on. So DB_SSL_VERIFY=0 is NOT a substitute
#     for DB_SSL_CA on the PDO path. (The mysqli-based importer,
#     _import_sql.php, can encrypt without a CA when DB_SSL_VERIFY=0.)
#
# DB_SSL_VERIFY=0 disables certificate verification: TLS still
# encrypts, but no longer proves the server is who it claims to be.
# Only ever use 0 against a throwaway test server.
# ------------------------------------------------------------------
DB_SSL_CA=
DB_SSL_VERIFY=1

# ------------------------------------------------------------------
# SMTP (read by mailer.php via env.php).
# ------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-character-app-password
MAIL_FROM=your-gmail@gmail.com
MAIL_FROM_NAME=islaFIND
SMTP_ENCRYPTION=tls

# ------------------------------------------------------------------
# Host switches — leave EVERY one of these unset for local WAMP.
# ------------------------------------------------------------------
# A host that rebuilds its container on every deploy has no persistent
# disk and ignores .htaccess. Each switch below changes one behaviour
# for such a host, and each one defaults to the local behaviour, so
# nothing here needs touching to develop on WAMP. See README
# ("Deploying") for which host needs which.
# ------------------------------------------------------------------

# Where the PHP session is stored.
#   files (default) — PHP's own storage. Correct for WAMP and for any
#                     host with a real disk.
#   mysql           — the isla_sessions table (created automatically on
#                     first use). Required on a host whose filesystem is
#                     wiped on deploy: file sessions would sign every
#                     visitor out on each release and would not be shared
#                     between instances. See include/session_store.php.
SESSION_DRIVER=files

# Send the hardening headers from PHP instead of letting Apache do it.
#   0 (default) — public/.htaccess sends them. Correct under Apache.
#   1           — the app sends X-Content-Type-Options, X-Frame-Options,
#                 Referrer-Policy and Permissions-Policy itself. Set this
#                 on a host that ignores .htaccess (nginx). Leave it 0 on
#                 Apache or every header is sent twice — and a duplicated
#                 X-Frame-Options is worse than none, because browsers
#                 disagree about which copy wins.
SEND_SECURITY_HEADERS=0

# Where uploaded profile pictures live.
#   local (default) — public/uploads/ on this server's own disk.
#   remote          — NOT IMPLEMENTED YET. The read side is ready (see
#                     UPLOADS_URL_BASE below); the write side needs an
#                     S3 Signature Version 4 PUT, which cannot be written
#                     honestly without a bucket to test against. Setting
#                     remote today fails the upload loudly and says why in
#                     the error log rather than pretending it was saved.
UPLOADS_DRIVER=local

# Base URL the browser should fetch pictures from. Empty = the app's own
# relative path ('uploads/<name>'), which is right when the files really
# sit in the web root. Set it to a bucket/CDN origin (no trailing slash
# needed) once pictures are stored elsewhere, and every page follows.
#   UPLOADS_URL_BASE=https://your-bucket.example.com/profile-pictures
UPLOADS_URL_BASE=
