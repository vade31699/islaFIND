# Copy this file to .env and fill in your real credentials.
# .env is NOT committed to version control; .env.example is.

# ------------------------------------------------------------------
# Database (read by db.php via env.php).
# The values below are the WAMP defaults, which is what the fallbacks
# in db.php use anyway — so you only need these lines if you want the
# configuration to be explicit or you are pointing at another server.
# ------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=final_app
DB_USER=root
DB_PASS=

# ------------------------------------------------------------------
# Database TLS (read by db.php, section 3b).
# Leave DB_SSL_CA out or empty for a local WAMP MySQL: it speaks
# plaintext and needs nothing here.
#
# Managed MySQL (TiDB Cloud Serverless, PlanetScale, ...) REFUSES
# plaintext connections, so there DB_SSL_CA is mandatory — without it
# the app cannot connect at all. Two details confirmed by testing
# against TiDB Cloud Starter:
#   * the value is a path to a CA certificate file, either absolute or
#     relative to the project root. certs/lets-encrypt-roots.pem is
#     committed and works as-is: TiDB Starter's certificates are
#     issued by Let's Encrypt, so no provider-specific CA download is
#     needed (that is a TiDB Cloud *Dedicated* thing).
#   * PDO has no "use TLS" switch — handing it a CA is what turns the
#     encrypted connection on. So DB_SSL_VERIFY=0 is NOT a substitute
#     for DB_SSL_CA on the PDO path. (The mysqli-based importer,
#     _import_sql.php, can encrypt without a CA when DB_SSL_VERIFY=0.)
#
# DB_SSL_VERIFY=0 disables certificate verification: TLS still
# encrypts, but no longer proves the server is who it claims to be.
# Only ever use 0 against a throwaway test server.
# ------------------------------------------------------------------
DB_SSL_CA=
DB_SSL_VERIFY=1

# ------------------------------------------------------------------
# SMTP (read by mailer.php via env.php).
# ------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-character-app-password
MAIL_FROM=your-gmail@gmail.com
MAIL_FROM_NAME=islaFIND
SMTP_ENCRYPTION=tls

# ------------------------------------------------------------------
# Host switches — leave EVERY one of these unset for local WAMP.
# ------------------------------------------------------------------
# A host that rebuilds its container on every deploy has no persistent
# disk and ignores .htaccess. Each switch below changes one behaviour
# for such a host, and each one defaults to the local behaviour, so
# nothing here needs touching to develop on WAMP. See README
# ("Deploying") for which host needs which.
# ------------------------------------------------------------------

# Where the PHP session is stored.
#   files (default) — PHP's own storage. Correct for WAMP and for any
#                     host with a real disk.
#   mysql           — the isla_sessions table (created automatically on
#                     first use). Required on a host whose filesystem is
#                     wiped on deploy: file sessions would sign every
#                     visitor out on each release and would not be shared
#                     between instances. See include/session_store.php.
SESSION_DRIVER=files

# Send the hardening headers from PHP instead of letting Apache do it.
#   0 (default) — public/.htaccess sends them. Correct under Apache.
#   1           — the app sends X-Content-Type-Options, X-Frame-Options,
#                 Referrer-Policy and Permissions-Policy itself. Set this
#                 on a host that ignores .htaccess (nginx). Leave it 0 on
#                 Apache or every header is sent twice — and a duplicated
#                 X-Frame-Options is worse than none, because browsers
#                 disagree about which copy wins.
SEND_SECURITY_HEADERS=0

# Where uploaded profile pictures live.
#   local (default) — public/uploads/ on this server's own disk. Right
#                     for WAMP and any host with a persistent disk.
#   remote          — S3-compatible object storage, through
#                     include/s3.php (AWS Signature Version 4). REQUIRED
#                     on a host that rebuilds its container on every
#                     deploy, where public/uploads/ is wiped on each
#                     release and every picture would vanish.
#
# On Laravel Cloud set this to remote. Attaching a bucket alone is not
# enough: it injects the AWS_* connection variables but not this switch,
# so with just a bucket the app keeps writing to the container disk — the
# upload says "updated", the row is saved, and every card shows a broken
# image. A read URL (UPLOADS_URL_BASE below) is optional: without one,
# pictures are signed and streamed by public/image.php.
UPLOADS_DRIVER=local

# Object storage — read only when UPLOADS_DRIVER=remote. Any S3-compatible
# service works (Cloudflare R2, AWS S3, MinIO, Backblaze B2, DO Spaces).
# On Laravel Cloud these are injected automatically once a bucket is
# attached as the environment's default disk. With no public origin set,
# public/image.php signs each read instead, so nothing here needs adding.
#   AWS_BUCKET=my-bucket
#   AWS_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
#   AWS_REGION=auto
#   AWS_ACCESS_KEY_ID=...
#   AWS_SECRET_ACCESS_KEY=...
#
# AWS_URL is set by the platform for its own bucket binding and is
# DELIBERATELY NOT used as a read origin by this app: a deployment whose
# AWS_URL pointed at a bucket custom domain that did not resolve showed a
# broken image for every photo, while public/image.php served those same
# bytes. Only UPLOADS_URL_BASE (below), the app's own switch, enables the
# direct-to-bucket fast path.
#
# Path-style addressing (endpoint/bucket/key) is the default and works on
# every provider; set to 0 only when the host requires virtual-hosted
# addressing (bucket.endpoint/key).
S3_PATH_STYLE=1

# Base URL the browser should fetch pictures from. Empty = the app's own
# relative path ('uploads/<name>') on the local driver, or public/image.php
# on the remote one, which signs a read of the object server-side. This is
# the ONLY variable that turns the direct fast path on (AWS_URL is ignored
# on purpose — see above). Set it to the bucket's public origin or a CDN in
# front of it (no trailing slash needed) and every page follows.
#
# OPTIONAL on the remote driver: a configured public origin is the fast
# path — the browser fetches the object directly, with no PHP hop and no
# app egress. Leave it empty and reads go through public/image.php instead,
# so pictures display either way. A private bucket simply never has a
# public origin to set — and if the origin you set ever stops resolving,
# empty it and the pictures come back.
#   UPLOADS_URL_BASE=https://cdn.example.com/profile-pictures
UPLOADS_URL_BASE=
