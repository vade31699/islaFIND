# Copy this file to .env and fill in your real credentials.
# .env is NOT committed to version control; .env.example is.

# ------------------------------------------------------------------
# Database (read by db.php via env.php).
# The values below are the WAMP defaults, which is what the fallbacks
# in db.php use anyway — so you only need these lines if you want the
# configuration to be explicit or you are pointing at another server.
# ------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=final_app
DB_USER=root
DB_PASS=

# ------------------------------------------------------------------
# Database TLS (read by db.php, section 3b).
# Leave DB_SSL_CA out or empty for a local WAMP MySQL: it speaks
# plaintext and needs nothing here.
#
# Managed MySQL servers (TiDB Cloud Serverless, PlanetScale, ...)
# REFUSE plaintext connections, so on those you must set DB_SSL_CA to
# the CA certificate the provider gives you — either an absolute path
# or one relative to the project root, e.g. certs/islandCA.pem.
# PDO ignores the DSN's ssl-mode; the certificate has to be handed to
# the driver, which is what these two keys are for.
#
# DB_SSL_VERIFY=0 turns certificate verification off. TLS still
# encrypts, but no longer proves the server is who it claims to be,
# so only ever use 0 against a throwaway test server.
# ------------------------------------------------------------------
DB_SSL_CA=
DB_SSL_VERIFY=1

# ------------------------------------------------------------------
# SMTP (read by mailer.php via env.php).
# ------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-character-app-password
MAIL_FROM=your-gmail@gmail.com
MAIL_FROM_NAME=islaFIND
SMTP_ENCRYPTION=tls
